@model IEnumerable<EmployeeCRUD.Models.Employee>

<h2>Employee List</h2>

<a asp-action="Create" class="btn btn-primary">
Add Employee
</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Department</td>
            <td>@item.Salary</td>
            <td>
                <a asp-action="Edit"
                   asp-route-id="@item.Id">
                   Edit
                </a>
                |
                <a asp-action="Delete"
                   asp-route-id="@item.Id">
                   Delete
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>