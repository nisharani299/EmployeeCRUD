@model EmployeeCRUD.Models.Employee

<h2>Create Employee</h2>

<form asp-action="Create">
    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Department</label>
        <input asp-for="Department" />
    </div>

    <div>
        <label>Salary</label>
        <input asp-for="Salary" />
    </div>

    <br/>

    <button type="submit">
        Save
    </button>
</form>